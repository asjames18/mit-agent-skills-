#!/usr/bin/env python3
"""ElevenLabs text-to-speech CLI. Usage:
   tts --voice <voice_id> --text "hello" --out out.mp3
   tts --voice <voice_id> --text-file script.txt --out out.mp3
   tts --list-voices
"""
import argparse, json, os, sys, urllib.request

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from cred import add_surrogate_to_request, read_response_body, read_json_response

HOSTS = ("api.elevenlabs.io",)
CRED = "custom.elevenlabs"

def _req(url, data=None, headers=None):
    req = urllib.request.Request(url, data=data, headers=headers or {})
    add_surrogate_to_request(req, CRED, allowed_hosts=HOSTS)
    # Some hosts challenge default python UAs
    if not req.get_header("User-agent"):
        req.add_header("User-Agent", "mit-agent-skills/1.0")
    return req

def list_voices():
    req = _req("https://api.elevenlabs.io/v1/voices")
    with urllib.request.urlopen(req, timeout=30) as resp:
        data = read_json_response(resp)
    for v in data.get("voices", []):
        labels = v.get("labels", {})
        print(f"{v['voice_id']}\t{v['name']}\t{labels.get('gender','?')}/{labels.get('age','?')}\t{v.get('description','')[:80]}")

def tts(voice_id, text, out, model="eleven_multilingual_v2"):
    payload = json.dumps({
        "text": text,
        "model_id": model,
        "voice_settings": {"stability": 0.5, "similarity_boost": 0.75},
    }).encode()
    req = _req(f"https://api.elevenlabs.io/v1/text-to-speech/{voice_id}",
               data=payload, headers={"Content-Type": "application/json", "Accept": "audio/mpeg"})
    with urllib.request.urlopen(req, timeout=120) as resp:
        audio = read_response_body(resp)
    with open(out, "wb") as f:
        f.write(audio)
    print(f"wrote {out} ({len(audio)} bytes)")

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--list-voices", action="store_true")
    ap.add_argument("--voice")
    ap.add_argument("--text")
    ap.add_argument("--text-file")
    ap.add_argument("--out", default="out.mp3")
    ap.add_argument("--model", default="eleven_multilingual_v2")
    a = ap.parse_args()
    if a.list_voices:
        return list_voices()
    text = a.text
    if a.text_file:
        text = open(a.text_file).read()
    if not a.voice or not text:
        ap.error("--voice and --text/--text-file required")
    tts(a.voice, text, a.out, a.model)

if __name__ == "__main__":
    main()
