#!/usr/bin/env python3
"""Post and reply on Threads via Meta's Threads API.

Auth comes from the Secure Vault connector `custom.threads` (OAuth2).
The raw token never touches disk, env vars, or logs; requests carry only
the `hsurr:` surrogate, attached via dynamic_credentials.

Usage:
  threads-post me
  threads-post quota
  threads-post post --text "..." [--reply-to <post-id>] [--reply-control EVERYONE|ACCOUNTS_YOU_FOLLOW|MENTIONED_ONLY]
  threads-post post-image --image-url <url> [--text "..."]
  threads-post replies --post-id <post-id>
  threads-post hide-reply --reply-id <id>
  threads-post unhide-reply --reply-id <id>
  threads-post queue-add --text "..." [--reply-to <post-id>] [--not-before <ISO>]
  threads-post queue-list
  threads-post run-queue            # publishes items marked approved=true
"""
import json
import os
import sys
import time
import urllib.parse
import urllib.request
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from cred import (
    add_surrogate_to_request,
    ensure_allowed_url,
    read_json_response,
)

API_HOST = "graph.threads.com"
API_BASE = f"https://{API_HOST}/v1.0"
CREDENTIAL = "custom.threads"
ALLOWED = (API_HOST,)
UA = "MIT-ThreadsPost/1.0"
QUEUE_PATH = str(Path(__file__).resolve().parent / "queue.json")


def api(method, path, params=None, timeout=30):
    url = API_BASE + path
    data = None
    headers = {"User-Agent": UA}
    if params is not None:
        data = urllib.parse.urlencode(params).encode()
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    add_surrogate_to_request(req, CREDENTIAL, allowed_hosts=ALLOWED)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return read_json_response(resp)
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace")[:2000]
        raise SystemExit(f"Threads API HTTP {e.code}: {body}")


def me():
    return api("GET", "/me?fields=" + urllib.parse.quote("id,username"))


def user_id():
    return me()["id"]


def quota():
    uid = user_id()
    fields = "quota_usage,config,reply_quota_usage,reply_config,delete_quota_usage,delete_config"
    return api("GET", f"/{uid}/threads_publishing_limit?fields={urllib.parse.quote(fields)}")


def create_container(uid, media_type, text=None, image_url=None, reply_to=None,
                     reply_control=None):
    params = {"media_type": media_type}
    if text:
        params["text"] = text
    if image_url:
        params["image_url"] = image_url
    if reply_to:
        params["reply_to_id"] = reply_to
    if reply_control:
        params["reply_control"] = reply_control
    return api("POST", f"/{uid}/threads", params)


def wait_finished(container_id, tries=10):
    for _ in range(tries):
        st = api("GET", f"/{container_id}?fields=status,error_message")
        if st.get("status") == "FINISHED":
            return
        if st.get("status") == "ERROR":
            raise SystemExit(f"container error: {st.get('error_message')}")
        time.sleep(6)
    raise SystemExit("container did not finish processing in time")


def publish(uid, container_id):
    return api("POST", f"/{uid}/threads_publish", {"creation_id": container_id})


def post_text(text, reply_to=None, reply_control=None):
    uid = user_id()
    c = create_container(uid, "TEXT", text=text, reply_to=reply_to,
                         reply_control=reply_control)
    cid = c["id"]
    wait_finished(cid)
    return publish(uid, cid)


def post_image(image_url, text=None):
    uid = user_id()
    c = create_container(uid, "IMAGE", text=text, image_url=image_url)
    cid = c["id"]
    wait_finished(cid)
    return publish(uid, cid)


def replies(post_id):
    fields = "id,text,username,timestamp,like_count,hide_status"
    return api("GET", f"/{post_id}/replies?fields={urllib.parse.quote(fields)}")


def set_hide(reply_id, hide):
    return api("POST", f"/{reply_id}/hide", {"hide": "true" if hide else "false"})


def load_queue():
    try:
        with open(QUEUE_PATH) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return []


def save_queue(items):
    with open(QUEUE_PATH, "w") as f:
        json.dump(items, f, indent=2)


def queue_add(text, reply_to=None, not_before=None):
    items = load_queue()
    item = {"text": text, "approved": False, "posted": False}
    if reply_to:
        item["reply_to"] = reply_to
    if not_before:
        item["not_before"] = not_before
    items.append(item)
    save_queue(items)
    return {"queued": len(items), "index": len(items) - 1}


def run_queue(now_iso=None):
    import datetime
    items = load_queue()
    now = now_iso or datetime.datetime.now(datetime.timezone.utc).isoformat()
    results = []
    for i, item in enumerate(items):
        if item.get("posted") or not item.get("approved"):
            continue
        if item.get("not_before") and item["not_before"] > now:
            continue
        try:
            res = post_text(item["text"], reply_to=item.get("reply_to"))
            item["posted"] = True
            item["post_id"] = res.get("id")
            results.append({"index": i, "ok": True, "id": res.get("id")})
        except SystemExit as e:
            results.append({"index": i, "ok": False, "error": str(e)})
            break  # stop on first failure; do not burn the queue
    save_queue(items)
    return results


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "help"
    args = argv[2:]

    def opt(name):
        for i, a in enumerate(args):
            if a == name and i + 1 < len(args):
                return args[i + 1]
        return None

    if cmd == "me":
        print(json.dumps(me(), indent=2))
    elif cmd == "quota":
        print(json.dumps(quota(), indent=2))
    elif cmd == "post":
        text = opt("--text") or sys.stdin.read().strip()
        if not text:
            raise SystemExit("--text is required")
        print(json.dumps(post_text(text, opt("--reply-to"), opt("--reply-control")), indent=2))
    elif cmd == "post-image":
        url = opt("--image-url")
        if not url:
            raise SystemExit("--image-url is required")
        print(json.dumps(post_image(url, opt("--text")), indent=2))
    elif cmd == "replies":
        pid = opt("--post-id") or raise_(SystemExit("--post-id is required"))
        print(json.dumps(replies(pid), indent=2))
    elif cmd == "hide-reply":
        rid = opt("--reply-id") or raise_(SystemExit("--reply-id is required"))
        print(json.dumps(set_hide(rid, True), indent=2))
    elif cmd == "unhide-reply":
        rid = opt("--reply-id") or raise_(SystemExit("--reply-id is required"))
        print(json.dumps(set_hide(rid, False), indent=2))
    elif cmd == "queue-add":
        text = opt("--text") or sys.stdin.read().strip()
        if not text:
            raise SystemExit("--text is required")
        print(json.dumps(queue_add(text, opt("--reply-to"), opt("--not-before")), indent=2))
    elif cmd == "queue-list":
        print(json.dumps(load_queue(), indent=2))
    elif cmd == "run-queue":
        print(json.dumps(run_queue(), indent=2))
    else:
        print(__doc__)
        raise SystemExit(2)


def raise_(e):
    raise e


if __name__ == "__main__":
    main(sys.argv)
