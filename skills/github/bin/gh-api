#!/usr/bin/env python3
"""Call the GitHub REST API with the user's stored custom.github credential.

Usage:
  gh-api GET /repos/asjames18/melanatedintech
  gh-api POST /repos/asjames18/melanatedintech/issues --data '{"title":"hi"}'
  gh-api GET /repos/asjames18/melanatedintech/tarball/main --out repo.tar.gz

Prints JSON responses to stdout (pretty-printed). With --out, writes the raw
response body to a file instead (for tarballs/zipballs).
"""
import argparse
import json
import os
import sys
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from cred import (
    add_surrogate_to_request,
    read_json_response,
    read_response_body,
    DynamicCredentialError,
)

API_BASE = "https://api.github.com"
ALLOWED = ("api.github.com",)
CREDENTIAL = "custom.github"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("method", help="GET, POST, PATCH, PUT, DELETE")
    ap.add_argument("path", help="API path, e.g. /repos/owner/repo")
    ap.add_argument("--data", default=None, help="JSON string or @file")
    ap.add_argument("--out", default=None, help="Write raw body to this file")
    args = ap.parse_args()

    url = API_BASE + args.path
    body = None
    if args.data:
        raw = args.data
        if raw.startswith("@"):
            with open(raw[1:], "r", encoding="utf-8") as f:
                raw = f.read()
        body = raw.encode("utf-8")

    req = urllib.request.Request(url, data=body, method=args.method.upper())
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("X-GitHub-Api-Version", "2022-11-28")
    if body is not None:
        req.add_header("Content-Type", "application/json")

    try:
        add_surrogate_to_request(
            req, CREDENTIAL, entry_name="access_token", allowed_hosts=ALLOWED
        )
    except DynamicCredentialError as e:
        print(f"credential error: {e}", file=sys.stderr)
        return 2

    try:
        with urllib.request.urlopen(req) as resp:
            if args.out:
                data = read_response_body(resp)
                with open(args.out, "wb") as f:
                    f.write(data)
                print(f"wrote {len(data)} bytes to {args.out}")
            else:
                payload = read_json_response(resp)
                print(json.dumps(payload, indent=2))
    except urllib.error.HTTPError as e:
        try:
            detail = e.read().decode("utf-8", "replace")
        except Exception:
            detail = "<unreadable>"
        print(f"HTTP {e.code}: {detail}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
